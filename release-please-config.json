{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "release-type": "simple",
      "version-file": "VERSION",
      "changelog-path": "CHANGELOG.md",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Added"
        },
        {
          "type": "fix",
          "section": "Fixed"
        },
        {
          "type": "docs",
          "section": "Changed"
        },
        {
          "type": "perf",
          "section": "Changed"
        },
        {
          "type": "refactor",
          "section": "Changed",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Maintenance",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "Maintenance",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Maintenance",
          "hidden": true
        }
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "plugins/kb/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": ".claude-plugin/marketplace.json",
          "jsonpath": "$.metadata.version"
        },
        {
          "type": "json",
          "path": ".claude-plugin/marketplace.json",
          "jsonpath": "$.plugins[0].version"
        },
        {
          "type": "generic",
          "path": "plugins/kb/agents/kb-operator.md"
        },
        {
          "type": "generic",
          "path": "plugins/kb/skills/kb-management/SKILL.md"
        },
        {
          "type": "generic",
          "path": "plugins/kb/skills/kb-setup/SKILL.md"
        }
      ]
    }
  }
}
